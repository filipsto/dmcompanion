          ],
          "objectType": "TABLE",
          "columns": [
            {
              "name": "COUNTRY_ID",
              "type": "CHAR(2)",
              "comment": [
                "Primary key of countries table."
              ],
              "mandatory": true,
              "isPrimaryKey": true
            },
            {
              "name": "COUNTRY_NAME",
              "type": "VARCHAR2(60)",
              "comment": [
                "Country name"
              ]
            },
            {
              "name": "REGION_ID",
              "type": "NUMBER",
              "comment": [
                "Region ID for the country. Foreign key to region_id column in the departments table."
              ],
              "isForeignKey": true
            }
          ],
          "primaryKey": {
